# ---------------------------------------------------------------------------
# Landing La Vieja Escuela
# Copiar a .env.local para desarrollo y cargar las mismas en Vercel.
# ---------------------------------------------------------------------------

# URL pública de la landing (para metadatos y links absolutos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sucursal Santa Fe 746 (sistema sala-de-profes-LVE) ---------------------
# URL base del sistema de la sucursal, sin barra final.
SUCURSAL_SANTA_FE_API_URL=https://sala-de-profes-lve.vercel.app
# Mismo valor que TIENDA_API_SECRET en el Vercel de esa sucursal.
# Generar uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUCURSAL_SANTA_FE_API_SECRET=

# --- Sucursal 24 de Septiembre y Chacabuco (sistema sala-de-profes-24) -----
SUCURSAL_24_API_URL=https://sala-de-profes-24.vercel.app
SUCURSAL_24_API_SECRET=

# --- Modo demo -------------------------------------------------------------
# Con TIENDA_MOCK=1 la landing usa sucursales simuladas en memoria
# (/api/mock-sucursal/...) y habilita el panel /dev/sucursales para marcar
# pedidos como pagados o retirados. NUNCA activarlo en producción.
TIENDA_MOCK=0

# --- Redes y secciones opcionales -------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/laviejaescuelatuc/
# Si se completa, el botón de la carta lleva acá y desaparecen los "Próximamente".
# Vacío: la sección anuncia la carta como próxima y manda a Instagram.
NEXT_PUBLIC_CARTA_URL=
# Pendiente de definir. Vacío: la sección de membresías no se muestra.
NEXT_PUBLIC_MEMBRESIAS_URL=
