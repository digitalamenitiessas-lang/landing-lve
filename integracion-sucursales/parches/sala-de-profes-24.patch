index 0000000..804dd92
--- /dev/null
+++ b/src/app/api/tienda/ventas/[id]/route.ts
@@ -0,0 +1,151 @@
+import { NextResponse } from 'next/server'
+import { logAudit } from '@/lib/audit'
+import { isManagerOrAbove } from '@/lib/roles'
+import { requireRole } from '@/lib/supabase/require-role'
+import { faltaMigracion, MENSAJE_FALTA_MIGRACION, tiendaAdmin } from '@/lib/tienda/db'
+import { detalleError } from '@/lib/tienda/respuestas'
+import type { EstadoVenta, TiendaVentaRow } from '@/lib/tienda/tipos'
+import { esUuid } from '@/lib/tienda/validar'
+import { aVentaStaff, cargarVenta, COLUMNAS_VENTA, nombresDePerfiles, pesos } from '@/lib/tienda/ventas'
+
+// ---------------------------------------------------------------------------
+// PATCH /api/tienda/ventas/[id]   body: { estado, motivo? }
+// ---------------------------------------------------------------------------
+// Mueve una venta web de estado:
+//   pendiente_pago → pagado      (llegó el comprobante por el monto exacto)
+//   pendiente_pago → cancelado
+//   pagado         → retirado    (el cliente se la llevó)
+//   pagado         → cancelado   (con motivo: hay que devolver la plata)
+// 'pagado' y 'cancelado': socio o encargado. 'retirado': también barista.
+// El update va condicionado al estado anterior: si otro lo movió en el medio,
+// responde 409 y no pisa nada.
+// ---------------------------------------------------------------------------
+
+export const dynamic = 'force-dynamic'
+
+type Destino = Exclude<EstadoVenta, 'pendiente_pago'>
+
+const TRANSICIONES: Record<EstadoVenta, readonly Destino[]> = {
+  pendiente_pago: ['pagado', 'cancelado'],
+  pagado: ['retirado', 'cancelado'],
+  retirado: [],
+  cancelado: [],
+}
+
+const ETIQUETA: Record<EstadoVenta, string> = {
+  pendiente_pago: 'por cobrar',
+  pagado: 'pagada',
+  retirado: 'entregada',
+  cancelado: 'cancelada',
+}
+
+function esDestino(v: unknown): v is Destino {
+  return v === 'pagado' || v === 'retirado' || v === 'cancelado'
+}
+
+export async function PATCH(request: Request, context: { params: Promise<{ id: string }> }) {
+  const auth = await requireRole(['socio', 'encargado', 'barista'])
+  if (auth.response) return auth.response
+  const { user } = auth
+
+  const { id } = await context.params
+  if (!esUuid(id)) return NextResponse.json({ error: 'Venta inválida' }, { status: 400 })
+
+  const body = (await request.json().catch(() => null)) as { estado?: unknown; motivo?: unknown } | null
+  if (!body || !esDestino(body.estado)) {
+    return NextResponse.json({ error: 'Estado inválido' }, { status: 400 })
+  }
+  const destino = body.estado
+
+  if (destino !== 'retirado' && !isManagerOrAbove(user.role)) {
+    return NextResponse.json(
+      { error: 'Solo un encargado o un socio puede marcar ventas como pagadas o cancelarlas' },
+      { status: 403 },
+    )
+  }
+
+  let motivo: string | null = null
+  if (body.motivo !== undefined && body.motivo !== null) {
+    if (typeof body.motivo !== 'string') return NextResponse.json({ error: 'Motivo inválido' }, { status: 400 })
+    motivo = body.motivo.trim().slice(0, 200) || null
+  }
+
+  try {
+    const admin = tiendaAdmin()
+
+    const { data: actualData, error: actualErr } = await admin
+      .from('tienda_ventas')
+      .select(COLUMNAS_VENTA)
+      .eq('id', id)
+      .maybeSingle()
+    if (actualErr) throw actualErr
+    if (!actualData) return NextResponse.json({ error: 'Venta no encontrada' }, { status: 404 })
+    const actual = actualData as unknown as TiendaVentaRow
+
+    if (!TRANSICIONES[actual.estado].includes(destino)) {
+      return NextResponse.json(
+        { error: `La venta ${actual.codigo} ya está ${ETIQUETA[actual.estado]}: no se puede marcar como ${ETIQUETA[destino]}.` },
+        { status: 409 },
+      )
+    }
+    if (destino === 'cancelado' && actual.estado === 'pagado' && !motivo) {
+      return NextResponse.json(
+        { error: 'Contá por qué se cancela una venta ya pagada (y acordate de devolver la transferencia).' },
+        { status: 400 },
+      )
+    }
+
+    const ahora = new Date().toISOString()
+    const cambios: Record<string, unknown> = { estado: destino }
+    if (destino === 'pagado') Object.assign(cambios, { pagado_at: ahora, pagado_por: user.id })
+    if (destino === 'retirado') Object.assign(cambios, { retirado_at: ahora, retirado_por: user.id })
+    if (destino === 'cancelado') {
+      Object.assign(cambios, { cancelado_at: ahora, cancelado_por: user.id, motivo_cancelacion: motivo })
+    }
+
+    const { data: movida, error: updErr } = await admin
+      .from('tienda_ventas')
+      .update(cambios)
+      .eq('id', id)
+      .eq('estado', actual.estado) // nadie la movió mientras tanto
+      .select('id')
+      .maybeSingle()
+    if (updErr) throw updErr
+    if (!movida) {
+      return NextResponse.json(
+        { error: `Alguien más cambió la venta ${actual.codigo} recién. Actualizá la lista.` },
+        { status: 409 },
+      )
+    }
+
+    const [cargada, perfil] = await Promise.all([
+      cargarVenta(admin, { id }),
+      admin.from('profiles').select('first_name, last_name').eq('id', user.id).maybeSingle(),
+    ])
+    const p = perfil.data as { first_name: string | null; last_name: string | null } | null
+    const userName = `${p?.first_name ?? ''} ${p?.last_name ?? ''}`.trim() || null
+    const total = Number(actual.total)
+
+    void logAudit(admin, {
+      userId: user.id,
+      userName,
+      action: `tienda_venta_${destino}`,
+      module: 'tienda',
+      entityType: 'tienda_venta',
+      entityId: id,
+      description: `Venta web ${actual.codigo} (${pesos(total)}) marcada como ${ETIQUETA[destino]}${motivo ? `: ${motivo}` : ''}`,
+      metadata: { codigo: actual.codigo, de: actual.estado, a: destino, total, motivo },
+    })
+
+    if (!cargada) return NextResponse.json({ ok: true })
+    const v = cargada.venta
+    const nombres = await nombresDePerfiles(admin, [v.pagado_por, v.retirado_por, v.cancelado_por])
+    return NextResponse.json({ ok: true, venta: aVentaStaff(v, cargada.items, nombres) })
+  } catch (err) {
+    if (faltaMigracion(err)) {
+      return NextResponse.json({ error: MENSAJE_FALTA_MIGRACION, migracion_pendiente: true }, { status: 503 })
+    }
+    console.error('[tienda] PATCH /api/tienda/ventas/[id]:', detalleError(err))
+    return NextResponse.json({ error: 'No se pudo actualizar la venta' }, { status: 500 })
+  }
+}
diff --git a/src/app/api/tienda/ventas/route.ts b/src/app/api/tienda/ventas/route.ts
new file mode 100644
