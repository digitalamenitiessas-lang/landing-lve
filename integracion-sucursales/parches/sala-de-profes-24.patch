@@ -0,0 +1,220 @@
+'use client'
+
+// ---------------------------------------------------------------------------
+// /tienda — Ventas de la tienda web (café 1/4 kg desde la landing)
+// ---------------------------------------------------------------------------
+// El cliente compra en la web → la venta llega acá "Por cobrar" → cuando llega
+// el comprobante por WhatsApp un encargado/socio la marca pagada → cuando el
+// cliente la retira, cualquiera del equipo (barista incluido) la marca
+// entregada. El ticket del cliente en la web se actualiza solo.
+// Socio, encargado y barista. Ajustes: solo socio y encargado.
+// ---------------------------------------------------------------------------
+
+import { useState } from 'react'
+import useSWR from 'swr'
+import { Lock, Settings2, ShoppingBag, X, AlertTriangle, RefreshCw } from 'lucide-react'
+import { useProfileContext } from '@/lib/hooks/use-profile'
+import { isManagerOrAbove } from '@/lib/roles'
+import { apiFetcher } from '@/lib/swr/fetchers'
+import { errorToast, successToast } from '@/lib/toast-helpers'
+import { FadeIn, StaggerList, StaggerItem } from '@/components/ui/motion'
+import { LoadingState } from '@/components/ui/LoadingState'
+import { EmptyState } from '@/components/ui/EmptyState'
+import type { EstadoVenta, RespuestaVentasStaff, VentaStaff } from '@/lib/tienda/tipos'
+import { VentaCard, type AccionVenta } from './_components/VentaCard'
+import { AjustesTienda } from './_components/AjustesTienda'
+import { fmtPesos } from './_components/formato'
+import { useAhora } from './_components/use-ahora'
+
+const ROLES_TIENDA = new Set(['socio', 'encargado', 'barista'])
+
+const TABS: { key: EstadoVenta; label: string; ayuda: string; vacio: string }[] = [
+  {
+    key: 'pendiente_pago',
+    label: 'Por cobrar',
+    ayuda: 'Esperando la transferencia. Marcala pagada solo cuando llegue el comprobante por el monto exacto.',
+    vacio: 'No hay ventas esperando pago.',
+  },
+  {
+    key: 'pagado',
+    label: 'Para entregar',
+    ayuda: 'Ya pagadas. Cuando el cliente pase, pedile el código y marcala entregada.',
+    vacio: 'No hay bolsas esperando que las retiren.',
+  },
+  {
+    key: 'retirado',
+    label: 'Entregados',
+    ayuda: 'Ventas cerradas: pagadas y retiradas.',
+    vacio: 'Todavía no se entregó ninguna venta web.',
+  },
+  {
+    key: 'cancelado',
+    label: 'Cancelados',
+    ayuda: 'Canceladas por el equipo o vencidas sin pago.',
+    vacio: 'No hay ventas canceladas.',
+  },
+]
+
+const MENSAJE_OK: Record<AccionVenta, string> = {
+  pagado: 'Venta cobrada: pasa a "Para entregar"',
+  retirado: 'Venta entregada',
+  cancelado: 'Venta cancelada',
+}
+
+export default function TiendaPage() {
+  const { profile, loading: cargandoPerfil } = useProfileContext()
+  const [tab, setTab] = useState<EstadoVenta>('pendiente_pago')
+  const [verAjustes, setVerAjustes] = useState(false)
+  const ahora = useAhora()
+
+  const puedeVer = ROLES_TIENDA.has(profile?.role ?? '')
+  const esManager = isManagerOrAbove(profile?.role)
+
+  const { data, error, isLoading, isValidating, mutate } = useSWR<RespuestaVentasStaff>(
+    puedeVer ? `/api/tienda/ventas?estado=${tab}` : null,
+    apiFetcher,
+    { refreshInterval: 30_000 },
+  )
+
+  async function accion(venta: VentaStaff, a: AccionVenta, motivo: string | null): Promise<boolean> {
+    try {
+      const res = await fetch(`/api/tienda/ventas/${venta.id}`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ estado: a, motivo }),
+      })
+      const json = await res.json().catch(() => ({}))
+      if (!res.ok) {
+        errorToast(`No se pudo actualizar ${venta.codigo}`, json.error ?? `Error ${res.status}`)
+        if (res.status === 409) void mutate()
+        return false
+      }
+      successToast(MENSAJE_OK[a], `${venta.codigo} · ${fmtPesos(venta.total)}`)
+      void mutate()
+      return true
+    } catch (err) {
+      errorToast(`No se pudo actualizar ${venta.codigo}`, err)
+      return false
+    }
+  }
+
+  if (cargandoPerfil) return <LoadingState />
+
+  if (!puedeVer) {
+    return (
+      <div className="pb-28">
+        <EmptyState
+          icon={Lock}
+          title="Acceso restringido"
+          description="Las ventas de la tienda web las ven socios, encargados y baristas."
+        />
+      </div>
+    )
+  }
+
+  const tabActual = TABS.find((t) => t.key === tab) ?? TABS[0]
+  const ventas = data?.ventas ?? []
+  const conteos = data?.conteos
+
+  return (
+    <div className="mx-auto max-w-2xl space-y-4 pb-28">
+      <FadeIn>
+        <div className="flex items-start gap-3">
+          <div className="min-w-0 flex-1">
+            <h1 className="font-display text-2xl font-bold tracking-tight text-[#3d2c24]">Tienda web</h1>
+            <p className="section-label mt-0.5">Café de la casa vendido desde la web</p>
+          </div>
+          {esManager && (
+            <button
+              type="button"
+              onClick={() => setVerAjustes((v) => !v)}
+              aria-expanded={verAjustes}
+              aria-controls="tienda-ajustes"
+              className="flex h-11 shrink-0 items-center gap-1.5 rounded-xl bg-white px-3 text-xs font-semibold text-[#3d2c24] ring-1 ring-[#ebe6df] active:scale-95"
+            >
+              {verAjustes ? <X className="size-4" aria-hidden /> : <Settings2 className="size-4" aria-hidden />}
+              {verAjustes ? 'Cerrar' : 'Ajustes'}
+            </button>
+          )}
+        </div>
+      </FadeIn>
+
+      {esManager && verAjustes && (
+        <FadeIn>
+          <section id="tienda-ajustes" aria-labelledby="tienda-ajustes-titulo" className="rounded-2xl bg-[#f3efe9] p-3">
+            <h2 id="tienda-ajustes-titulo" className="mb-3 px-1 text-sm font-bold text-[#3d2c24]">
+              Ajustes de la tienda
+            </h2>
+            <AjustesTienda />
+          </section>
+        </FadeIn>
+      )}
+
+      {/* Pestañas */}
+      <div role="tablist" aria-label="Estado de las ventas" className="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1">
+        {TABS.map((t) => {
+          const n = conteos?.[t.key]
+          const activa = t.key === tab
+          return (
+            <button
+              key={t.key}
+              type="button"
+              role="tab"
+              aria-selected={activa}
+              aria-controls="tienda-lista"
+              onClick={() => setTab(t.key)}
+              className={`min-h-11 shrink-0 ${activa ? 'pill pill-active' : 'pill pill-inactive'}`}
+            >
+              {t.label}
+              {n !== undefined && n > 0 && (
+                <span
+                  className={`rounded-full px-1.5 text-[10px] font-bold tabular-nums ${
+                    activa ? 'bg-white/25 text-white' : t.key === 'pendiente_pago' ? 'bg-[#fdf6ec] text-[#d4943a]' : 'bg-white text-[#7d6c64]'
+                  }`}
+                >
+                  {n}
+                </span>
+              )}
+            </button>
+          )
+        })}
+      </div>
+
+      <div className="flex items-start justify-between gap-3">
+        <p className="text-xs text-[#7d6c64]">{tabActual.ayuda}</p>
+        <button
+          type="button"
+          onClick={() => void mutate()}
+          aria-label="Actualizar la lista"
+          className="flex size-11 shrink-0 items-center justify-center rounded-xl text-[#a39e97] active:scale-95"
+        >
+          <RefreshCw className={`size-4 ${isValidating ? 'animate-spin' : ''}`} aria-hidden />
+        </button>
+      </div>
+
+      <div id="tienda-lista" role="tabpanel" aria-live="polite" aria-busy={isLoading}>
+        {isLoading && !data ? (
+          <LoadingState message="Cargando ventas..." />
+        ) : error && !data ? (
+          <div className="rounded-2xl bg-[#fdf6ec] px-4 py-3 ring-1 ring-[#d4943a]/30">
+            <p className="flex items-center gap-1.5 text-sm font-semibold text-[#d4943a]">
+              <AlertTriangle className="size-4" aria-hidden />
+              No se pudieron cargar las ventas web
+            </p>
+            <p className="mt-0.5 text-xs text-[#7d6c64]">{error instanceof Error ? error.message : 'Probá de nuevo en un rato.'}</p>
+          </div>
+        ) : ventas.length === 0 ? (
+          <EmptyState icon={ShoppingBag} title="Nada por acá" description={tabActual.vacio} />
+        ) : (
+          <StaggerList className="space-y-3">
+            {ventas.map((v) => (
+              <StaggerItem key={v.id}>
+                <VentaCard venta={v} esManager={esManager} ahora={ahora} onAccion={accion} />
+              </StaggerItem>
+            ))}
+          </StaggerList>
+        )}
+      </div>
+    </div>
+  )
+}
