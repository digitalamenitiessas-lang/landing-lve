+import { protegerRutaPublica } from '@/lib/tienda/auth'
+import { aProductoPublico, leerConfig, leerProductos } from '@/lib/tienda/config'
+import { faltaMigracion, tiendaAdmin } from '@/lib/tienda/db'
+import { detalleError, errorInterno, jsonPublico } from '@/lib/tienda/respuestas'
+import { CONTRATO_VERSION, type Catalogo } from '@/lib/tienda/tipos'
+
+// ---------------------------------------------------------------------------
+// GET /api/tienda/publico/catalogo — contrato v1 con la landing
+// ---------------------------------------------------------------------------
+// Productos (ordenados por `orden`) + configuración de la tienda de esta
+// sucursal. Protegida con Authorization: Bearer <TIENDA_API_SECRET>.
+// Un producto sin precio cargado sale como no disponible.
+// ---------------------------------------------------------------------------
+
+export const dynamic = 'force-dynamic'
+
+export async function GET(request: Request) {
+  const rechazo = protegerRutaPublica(request)
+  if (rechazo) return rechazo
+
+  try {
+    const admin = tiendaAdmin()
+    const [config, filas] = await Promise.all([leerConfig(admin), leerProductos(admin)])
+
+    const catalogo: Catalogo = {
+      version: CONTRATO_VERSION,
+      venta_habilitada: config.venta_habilitada,
+      mensaje: config.mensaje,
+      productos: filas.map(aProductoPublico),
+      pago: config.pago,
+      whatsapp: config.whatsapp,
+      retiro: config.retiro,
+      vencimiento_horas: config.vencimiento_horas,
+    }
+    return jsonPublico(catalogo)
+  } catch (err) {
+    console.error(
+      `[tienda] GET catalogo: ${faltaMigracion(err) ? 'falta la migración 20261004_tienda_web.sql' : detalleError(err)}`,
+    )
+    return errorInterno()
+  }
+}
diff --git a/src/app/api/tienda/publico/ventas/[codigo]/route.ts b/src/app/api/tienda/publico/ventas/[codigo]/route.ts
