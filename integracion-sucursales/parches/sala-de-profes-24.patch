+import type { SupabaseClient } from '@supabase/supabase-js'
+import { createAdminClient } from '@/lib/supabase/admin'
+
+// ---------------------------------------------------------------------------
+// Cliente service_role para las tablas tienda_*.
+// ---------------------------------------------------------------------------
+// Las tablas nuevas no están en src/types/database.ts (ese archivo difiere
+// entre sucursales y no lo tocamos), así que se usa el cliente sin tipar y
+// cada consulta castea a los tipos de ./tipos. Solo server-side.
+// Tira si faltan NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: las
+// rutas lo envuelven en try/catch y responden 500 controlado.
+// ---------------------------------------------------------------------------
+
+export type TiendaDb = SupabaseClient
+
+export function tiendaAdmin(): TiendaDb {
+  return createAdminClient() as unknown as TiendaDb
+}
+
+/** ¿El error de Supabase es porque falta la migración (tabla o función inexistente)? */
+export function faltaMigracion(err: unknown): boolean {
+  if (!err || typeof err !== 'object') return false
+  const code = (err as { code?: unknown }).code
+  // 42P01 tabla inexistente · 42883 función inexistente ·
+  // PGRST202/PGRST205 PostgREST no la encuentra en su caché de esquema
+  return code === '42P01' || code === '42883' || code === 'PGRST202' || code === 'PGRST205'
+}
+
+export const MENSAJE_FALTA_MIGRACION =
+  'Falta aplicar la migración 20261004_tienda_web.sql en la base de esta sucursal.'
