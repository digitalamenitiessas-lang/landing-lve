+'use client'
+
+import { useEffect, useState } from 'react'
+
+/**
+ * Hora actual que se refresca sola cada `cadaMs` (por defecto 1 minuto),
+ * para que "vence en 3 horas" se mantenga al día sin recargar.
+ */
+export function useAhora(cadaMs = 60_000): number {
+  const [ahora, setAhora] = useState(() => Date.now())
+  useEffect(() => {
+    const t = setInterval(() => setAhora(Date.now()), cadaMs)
+    return () => clearInterval(t)
+  }, [cadaMs])
+  return ahora
+}
diff --git a/src/app/(app)/tienda/page.tsx b/src/app/(app)/tienda/page.tsx
