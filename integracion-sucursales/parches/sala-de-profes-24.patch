index 0000000..ae9d690
--- /dev/null
+++ b/src/app/api/tienda/config/route.ts
@@ -0,0 +1,124 @@
+import { NextResponse } from 'next/server'
+import { logAudit } from '@/lib/audit'
+import { requireRole } from '@/lib/supabase/require-role'
+import { tiendaSecretoConfigurado } from '@/lib/tienda/auth'
+import {
+  aplicarPatchConfig,
+  aProductoStaff,
+  leerConfig,
+  leerProductos,
+  prefijoCodigo,
+  SETTINGS_KEY,
+  validarPatchProductos,
+} from '@/lib/tienda/config'
+import { faltaMigracion, MENSAJE_FALTA_MIGRACION, tiendaAdmin, type TiendaDb } from '@/lib/tienda/db'
+import { detalleError } from '@/lib/tienda/respuestas'
+import type { RespuestaConfigStaff } from '@/lib/tienda/tipos'
+
+// ---------------------------------------------------------------------------
+// GET   /api/tienda/config — ajustes de la tienda web + productos
+// PATCH /api/tienda/config — body { config?: {...parcial}, productos?: [{ id, ...cambios }] }
+// ---------------------------------------------------------------------------
+// Solo socio y encargado. La config vive en app_settings (key 'tienda'); los
+// productos en tienda_productos. Nunca devuelve el valor de TIENDA_API_SECRET:
+// solo si está configurado.
+// ---------------------------------------------------------------------------
+
+export const dynamic = 'force-dynamic'
+
+const ROLES = ['socio', 'encargado'] as const
+
+async function armarRespuesta(admin: TiendaDb): Promise<RespuestaConfigStaff> {
+  const [config, productos] = await Promise.all([leerConfig(admin), leerProductos(admin)])
+  return {
+    config,
+    productos: productos.map(aProductoStaff),
+    prefijo: prefijoCodigo(),
+    secreto_configurado: tiendaSecretoConfigurado(),
+  }
+}
+
+function errorServidor(err: unknown, donde: string) {
+  if (faltaMigracion(err)) {
+    return NextResponse.json({ error: MENSAJE_FALTA_MIGRACION, migracion_pendiente: true }, { status: 503 })
+  }
+  console.error(`[tienda] ${donde}:`, detalleError(err))
+  return NextResponse.json({ error: 'No se pudieron leer o guardar los ajustes de la tienda' }, { status: 500 })
+}
+
+export async function GET() {
+  const auth = await requireRole(ROLES)
+  if (auth.response) return auth.response
+  try {
+    return NextResponse.json(await armarRespuesta(tiendaAdmin()), { headers: { 'Cache-Control': 'no-store' } })
+  } catch (err) {
+    return errorServidor(err, 'GET /api/tienda/config')
+  }
+}
+
+export async function PATCH(request: Request) {
+  const auth = await requireRole(ROLES)
+  if (auth.response) return auth.response
+  const { user } = auth
+
+  const body = (await request.json().catch(() => null)) as { config?: unknown; productos?: unknown } | null
+  if (!body || typeof body !== 'object') return NextResponse.json({ error: 'Body inválido' }, { status: 400 })
+
+  try {
+    const admin = tiendaAdmin()
+    const [actual, productosActuales] = await Promise.all([leerConfig(admin), leerProductos(admin)])
+
+    const config = aplicarPatchConfig(actual, body.config)
+    if (!config.ok) return NextResponse.json({ error: config.error, campo: config.campo }, { status: 400 })
+    const productos = validarPatchProductos(body.productos, productosActuales)
+    if (!productos.ok) return NextResponse.json({ error: productos.error, campo: productos.campo }, { status: 400 })
+
+    // Productos primero: así "activar la venta + poner precio" en un mismo
+    // guardado no deja un instante la venta abierta con el café sin precio.
+    for (const p of productos.data) {
+      const { error } = await admin.from('tienda_productos').update(p.cambios).eq('id', p.id)
+      if (error) throw error
+    }
+
+    const configCambio = JSON.stringify(config.data) !== JSON.stringify(actual)
+    if (configCambio) {
+      const { error } = await admin.from('app_settings').upsert({
+        key: SETTINGS_KEY,
+        value: config.data,
+        updated_by: user.id,
+        updated_at: new Date().toISOString(),
+      })
+      if (error) throw error
+    }
+
+    if (configCambio || productos.data.length > 0) {
+      const { data: perfil } = await admin.from('profiles').select('first_name, last_name').eq('id', user.id).maybeSingle()
+      const p = perfil as { first_name: string | null; last_name: string | null } | null
+      const userName = `${p?.first_name ?? ''} ${p?.last_name ?? ''}`.trim() || null
+      const abrio = !actual.venta_habilitada && config.data.venta_habilitada
+      const cerro = actual.venta_habilitada && !config.data.venta_habilitada
+      void logAudit(admin, {
+        userId: user.id,
+        userName,
+        action: 'tienda_config',
+        module: 'tienda',
+        entityType: 'app_settings',
+        entityId: SETTINGS_KEY,
+        description: abrio
+          ? 'Activó la venta web'
+          : cerro
+            ? 'Pausó la venta web'
+            : 'Cambió los ajustes de la tienda web',
+        metadata: {
+          antes: actual,
+          despues: config.data,
+          productos: productos.data,
+        },
+      })
+    }
+
+    return NextResponse.json(await armarRespuesta(admin))
+  } catch (err) {
+    return errorServidor(err, 'PATCH /api/tienda/config')
+  }
+}
