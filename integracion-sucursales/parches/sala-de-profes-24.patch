+import { format, formatDistanceStrict } from 'date-fns'
+import { es } from 'date-fns/locale/es'
+import type { EstadoVenta } from '@/lib/tienda/tipos'
+
+// ---------------------------------------------------------------------------
+// Helpers de presentación de /tienda
+// ---------------------------------------------------------------------------
+
+/** 9500 → "$ 9.500" */
+export function fmtPesos(n: number): string {
+  return `$ ${n.toLocaleString('es-AR', { maximumFractionDigits: 2 })}`
+}
+
+/** "lun 6 oct, 18:30" */
+export function fmtFechaHora(iso: string): string {
+  return format(new Date(iso), "EEE d MMM, HH:mm", { locale: es })
+}
+
+/** "hace 2 horas" / "en 5 horas" respecto de `ahora`. */
+export function fmtRelativo(iso: string, ahora: number): string {
+  return formatDistanceStrict(new Date(iso), new Date(ahora), { locale: es, addSuffix: true })
+}
+
+export const ESTADO_UI: Record<EstadoVenta, { label: string; color: string; bg: string }> = {
+  pendiente_pago: { label: 'Por cobrar', color: '#d4943a', bg: '#fdf6ec' },
+  pagado: { label: 'Pagado · para entregar', color: '#006d5a', bg: '#e8f5f1' },
+  retirado: { label: 'Entregado', color: '#a39e97', bg: '#f3efe9' },
+  cancelado: { label: 'Cancelado', color: '#ea504c', bg: '#fef2f2' },
+}
+
+/**
+ * Teléfono como lo escribió el cliente → número para wa.me (Argentina).
+ * "381 555-1234" → "5493815551234"; "+54 9 381 555-1234" queda igual;
+ * "0381 15-555-1234" → "5493815551234". Si no se puede deducir, null.
+ */
+export function telefonoParaWhatsApp(telefono: string): string | null {
+  let d = telefono.replace(/\D/g, '')
+  if (d.startsWith('00')) d = d.slice(2)
+  if (d.startsWith('54')) {
+    d = d.slice(2)
+    if (d.startsWith('9')) d = d.slice(1)
+  }
+  if (d.startsWith('0')) d = d.slice(1)
+  // característica (2 a 4 dígitos) + 15 + número: se saca el 15
+  if (d.length === 12) {
+    for (const largo of [2, 3, 4]) {
+      if (d.slice(largo, largo + 2) === '15') {
+        d = d.slice(0, largo) + d.slice(largo + 2)
+        break
+      }
+    }
+  }
+  return d.length === 10 ? `549${d}` : null
+}
+
+/** Link para escribirle al cliente por WhatsApp con el código del pedido. */
+export function linkWhatsAppCliente(telefono: string, nombre: string, codigo: string): string | null {
+  const numero = telefonoParaWhatsApp(telefono)
+  if (!numero) return null
+  const pila = nombre.trim().split(/\s+/)[0] ?? ''
+  const texto = `¡Hola ${pila}! Te escribimos de La Vieja Escuela por tu pedido ${codigo} de la web.`
+  return `https://wa.me/${numero}?text=${encodeURIComponent(texto)}`
+}
+
+/** tel: con solo dígitos y el + si lo tenía. */
+export function linkTelefono(telefono: string): string {
+  const t = telefono.trim()
+  return `tel:${t.startsWith('+') ? '+' : ''}${t.replace(/\D/g, '')}`
+}
+
+/** Cantidad total de unidades (bolsas) de una venta. */
+export function unidades(items: Array<{ cantidad: number }>): number {
+  return items.reduce((acc, it) => acc + it.cantidad, 0)
+}
