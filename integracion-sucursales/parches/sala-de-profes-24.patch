+import { NextResponse } from 'next/server'
+import { STATUS_POR_ERROR, type CodigoError, type ErrorRespuesta } from './tipos'
+
+// ---------------------------------------------------------------------------
+// Respuestas de las rutas públicas de la tienda (/api/tienda/publico/*).
+// Todas salen con Cache-Control: no-store: son datos por pedido y cambian.
+// ---------------------------------------------------------------------------
+
+const SIN_CACHE = { 'Cache-Control': 'no-store' } as const
+
+export function jsonPublico<T>(body: T, status = 200): NextResponse<T> {
+  return NextResponse.json(body, { status, headers: SIN_CACHE })
+}
+
+/**
+ * Error con la forma del contrato: { error, codigo, campo? }.
+ * `campo` se omite si viene vacío o null (el contrato no admite null).
+ */
+export function errorPublico(
+  codigo: CodigoError,
+  error: string,
+  opts?: { campo?: string | null; status?: number },
+): NextResponse<ErrorRespuesta> {
+  const body: ErrorRespuesta = { error, codigo }
+  if (opts?.campo) body.campo = opts.campo
+  return jsonPublico(body, opts?.status ?? STATUS_POR_ERROR[codigo])
+}
+
+export const MENSAJE_ERROR_INTERNO = 'Tuvimos un problema para procesar el pedido. Probá de nuevo en un ratito.'
+
+export function errorInterno(): NextResponse<ErrorRespuesta> {
+  return errorPublico('error_interno', MENSAJE_ERROR_INTERNO)
+}
+
+/**
+ * 404 único para "no existe ese código" y "el token no corresponde".
+ * Es el mismo cuerpo a propósito: así no se puede averiguar qué códigos existen.
+ */
+export function noEncontrada(): NextResponse<ErrorRespuesta> {
+  return errorPublico('no_encontrada', 'No encontramos ese pedido.')
+}
+
+/** Detalle técnico de un error para el log, sin datos del cliente. */
+export function detalleError(err: unknown): string {
+  if (err && typeof err === 'object') {
+    const e = err as { code?: unknown; message?: unknown }
+    const code = typeof e.code === 'string' ? e.code : ''
+    const message = typeof e.message === 'string' ? e.message.slice(0, 200) : ''
+    return [code, message].filter(Boolean).join(' ') || 'error desconocido'
+  }
+  return typeof err === 'string' ? err.slice(0, 200) : 'error desconocido'
+}
