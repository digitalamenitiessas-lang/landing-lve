diff --git a/src/lib/tienda/auth.ts b/src/lib/tienda/auth.ts
new file mode 100644
index 0000000..e274fa3
--- /dev/null
+++ b/src/lib/tienda/auth.ts
@@ -0,0 +1,75 @@
+import { createHash, timingSafeEqual } from 'node:crypto'
+import type { NextResponse } from 'next/server'
+import { errorPublico } from './respuestas'
+import { CONTRATO_VERSION, type ErrorRespuesta } from './tipos'
+
+// ---------------------------------------------------------------------------
+// Autenticación de las rutas públicas de la tienda (/api/tienda/publico/*)
+// ---------------------------------------------------------------------------
+// La landing manda en cada llamada:
+//   Authorization: Bearer <TIENDA_API_SECRET>
+//   X-Contrato-Version: 1
+// Sin TIENDA_API_SECRET (o con uno de menos de 32 caracteres) las rutas
+// responden 503 SIEMPRE: nunca quedan abiertas por un olvido de configuración.
+// ---------------------------------------------------------------------------
+
+/** Largo mínimo del secreto. Generarlo con: openssl rand -hex 32 (64 caracteres). */
+export const LARGO_MINIMO_SECRETO = 32
+
+/** El secreto configurado, o null si falta o es demasiado corto. */
+function secretoConfigurado(): string | null {
+  const s = process.env.TIENDA_API_SECRET?.trim()
+  return s && s.length >= LARGO_MINIMO_SECRETO ? s : null
+}
+
+export function tiendaSecretoConfigurado(): boolean {
+  return secretoConfigurado() !== null
+}
+
+/**
+ * Compara dos textos en tiempo constante. Se comparan sus sha-256 para que
+ * los buffers tengan siempre el mismo largo y no se filtre el largo del secreto.
+ */
+export function igualesEnTiempoConstante(a: string, b: string): boolean {
+  const ha = createHash('sha256').update(a, 'utf8').digest()
+  const hb = createHash('sha256').update(b, 'utf8').digest()
+  return timingSafeEqual(ha, hb)
+}
+
+/**
+ * Verifica `Authorization: Bearer <TIENDA_API_SECRET>`.
+ * Devuelve null si está bien, o la respuesta de error lista para retornar.
+ */
+export function verificarSecreto(request: Request): NextResponse<ErrorRespuesta> | null {
+  const esperado = secretoConfigurado()
+  if (!esperado) {
+    console.error('[tienda] TIENDA_API_SECRET no está configurado (o tiene menos de 32 caracteres): la tienda web está cerrada')
+    return errorPublico('error_interno', 'La tienda web de esta sucursal no está configurada.', { status: 503 })
+  }
+
+  const header = request.headers.get('authorization') ?? ''
+  const match = /^Bearer[ ]+(.+)$/i.exec(header.trim())
+  const recibido = match?.[1]?.trim() ?? ''
+  // Se compara igual aunque venga vacío, para no responder más rápido en ese caso.
+  const ok = igualesEnTiempoConstante(recibido, esperado)
+  if (!ok || !recibido) {
+    return errorPublico('no_autorizado', 'Secreto inválido.')
+  }
+  return null
+}
+
+/** Si viene X-Contrato-Version, tiene que ser la nuestra. */
+export function verificarVersion(request: Request): NextResponse<ErrorRespuesta> | null {
+  const version = request.headers.get('x-contrato-version')
+  if (version !== null && version.trim() !== String(CONTRATO_VERSION)) {
+    return errorPublico('datos_invalidos', `Versión de contrato no soportada (esperada ${CONTRATO_VERSION}).`, {
+      campo: 'X-Contrato-Version',
+    })
+  }
+  return null
+}
+
+/** Secreto + versión: lo primero que hace cada ruta pública. */
+export function protegerRutaPublica(request: Request): NextResponse<ErrorRespuesta> | null {
+  return verificarSecreto(request) ?? verificarVersion(request)
+}
diff --git a/src/lib/tienda/config.ts b/src/lib/tienda/config.ts
new file mode 100644
index 0000000..970360d
--- /dev/null
+++ b/src/lib/tienda/config.ts
@@ -0,0 +1,408 @@
+import type { TiendaDb } from './db'
+import type {
+  ConfigPatchBody,
+  DatosPago,
+  DatosRetiro,
+  Opcion,
+  Producto,
+  ProductoStaff,
+  TiendaConfig,
+  TiendaProductoRow,
+} from './tipos'
+
+// ---------------------------------------------------------------------------
+// Tienda web — configuración (app_settings 'tienda') y productos
+// ---------------------------------------------------------------------------
+
+export const SETTINGS_KEY = 'tienda'
+
+/** Lo mismo que siembra la migración: arranca apagada. */
+export const CONFIG_DEFAULT: TiendaConfig = {
+  venta_habilitada: false,
+  mensaje: null,
+  pago: { alias: null, cbu: null, titular: null, banco: null, cuit: null },
+  whatsapp: null,
+  retiro: { direccion: null, horario: null, indicaciones: null },
+  vencimiento_horas: 48,
+}
+
+/** Tope de horas de reserva (el mismo que aplica tienda_crear_venta). */
+export const VENCIMIENTO_MAX_HORAS = 720
+
+const PREFIJO_REGEX = /^[A-Z0-9-]{2,12}$/
+
+/**
+ * Prefijo de los códigos de venta de esta sucursal: TIENDA_PREFIJO_CODIGO
+ * (WEB-SF en Santa Fe, WEB-24 en la 24). Si falta o es inválido, 'WEB'.
+ */
+export function prefijoCodigo(): string {
+  const p = process.env.TIENDA_PREFIJO_CODIGO?.trim().toUpperCase()
+  return p && PREFIJO_REGEX.test(p) ? p : 'WEB'
+}
+
+/* ------------------------------------------------------------------ */
+/* Lectura defensiva                                                   */
+/* ------------------------------------------------------------------ */
+
+function texto(v: unknown, max = 300): string | null {
+  if (typeof v !== 'string') return null
+  const t = v.trim()
+  return t.length > 0 ? t.slice(0, max) : null
+}
+
+function esObjeto(v: unknown): v is Record<string, unknown> {
+  return typeof v === 'object' && v !== null && !Array.isArray(v)
+}
+
+/**
+ * Normaliza lo guardado en app_settings a la forma del contrato. Si alguien
+ * editó el JSON a mano y dejó algo raro, se cae al default de ese campo en
+ * lugar de mandarle a la landing algo que no valida.
+ */
+export function normalizarConfig(value: unknown): TiendaConfig {
+  const v = esObjeto(value) ? value : {}
+  const pago = esObjeto(v.pago) ? v.pago : {}
+  const retiro = esObjeto(v.retiro) ? v.retiro : {}
+  const wa = typeof v.whatsapp === 'string' ? v.whatsapp.replace(/\D/g, '') : ''
+  const horas = v.vencimiento_horas
+  return {
+    venta_habilitada: v.venta_habilitada === true,
+    mensaje: texto(v.mensaje, 280),
+    pago: {
+      alias: texto(pago.alias, 40),
+      cbu: texto(pago.cbu, 40),
+      titular: texto(pago.titular, 120),
+      banco: texto(pago.banco, 80),
+      cuit: texto(pago.cuit, 20),
+    },
+    whatsapp: /^\d{10,15}$/.test(wa) ? wa : null,
+    retiro: {
+      direccion: texto(retiro.direccion, 200),
+      horario: texto(retiro.horario, 200),
+      indicaciones: texto(retiro.indicaciones, 300),
+    },
+    vencimiento_horas:
+      typeof horas === 'number' && Number.isInteger(horas) && horas > 0
+        ? Math.min(horas, VENCIMIENTO_MAX_HORAS)
+        : CONFIG_DEFAULT.vencimiento_horas,
+  }
+}
+
+export async function leerConfig(admin: TiendaDb): Promise<TiendaConfig> {
+  const { data, error } = await admin.from('app_settings').select('value').eq('key', SETTINGS_KEY).maybeSingle()
+  if (error) throw error
+  return normalizarConfig((data as { value?: unknown } | null)?.value)
+}
+
+/* ------------------------------------------------------------------ */
+/* Productos                                                           */
+/* ------------------------------------------------------------------ */
+
+export const COLUMNAS_PRODUCTO =
+  'id, slug, nombre, descripcion, presentacion, precio, disponible, opciones, max_por_pedido, orden, created_at, updated_at'
+
+/**
+ * Opciones con la forma del contrato. Se descartan las mal armadas (sin id,
+ * sin nombre o sin valores) para que la landing no rechace el catálogo entero.
+ */
+export function normalizarOpciones(v: unknown): Opcion[] {
+  if (!Array.isArray(v)) return []
+  const out: Opcion[] = []
+  for (const o of v) {
+    if (!esObjeto(o)) continue
+    const id = texto(o.id, 60)
+    const nombre = texto(o.nombre, 80)
+    if (!id || !nombre || !Array.isArray(o.valores)) continue
+    const valores = o.valores
+      .filter(esObjeto)
+      .map((x) => ({ id: texto(x.id, 60), nombre: texto(x.nombre, 120) }))
+      .filter((x): x is { id: string; nombre: string } => Boolean(x.id && x.nombre))
+    if (valores.length === 0) continue
+    out.push({ id, nombre, requerida: o.requerida === true, valores })
+  }
+  return out
+}
+
+function maxPorPedido(v: unknown): number {
+  return typeof v === 'number' && Number.isInteger(v) && v >= 1 ? Math.min(v, 20) : 1
+}
+
+/** Producto para la landing: sin precio cargado no está disponible. */
+export function aProductoPublico(row: TiendaProductoRow): Producto {
+  const precio = Number(row.precio)
+  const precioOk = Number.isFinite(precio) && precio > 0
+  return {
+    id: row.id,
+    slug: row.slug,
+    nombre: row.nombre,
+    descripcion: row.descripcion,
+    presentacion: row.presentacion,
+    precio: precioOk ? precio : 0,
+    disponible: Boolean(row.disponible) && precioOk,
+    opciones: normalizarOpciones(row.opciones),
+    max_por_pedido: maxPorPedido(row.max_por_pedido),
+  }
+}
+
+export function aProductoStaff(row: TiendaProductoRow): ProductoStaff {
+  const precio = Number(row.precio)
+  return {
+    id: row.id,
+    slug: row.slug,
+    nombre: row.nombre,
+    descripcion: row.descripcion,
+    presentacion: row.presentacion,
+    precio: Number.isFinite(precio) ? precio : 0,
+    disponible: Boolean(row.disponible),
+    max_por_pedido: maxPorPedido(row.max_por_pedido),
+    orden: row.orden,
+  }
+}
+
+export async function leerProductos(admin: TiendaDb): Promise<TiendaProductoRow[]> {
+  const { data, error } = await admin
+    .from('tienda_productos')
+    .select(COLUMNAS_PRODUCTO)
+    .order('orden', { ascending: true })
+    .order('nombre', { ascending: true })
+  if (error) throw error
+  return (data ?? []) as unknown as TiendaProductoRow[]
+}
+
+/* ------------------------------------------------------------------ */
+/* Validación de los ajustes que manda el staff                        */
+/* ------------------------------------------------------------------ */
+
+type Fallo = { ok: false; error: string; campo: string }
+type Ok<T> = { ok: true; data: T }
+
+const ALIAS_REGEX = /^[A-Za-z0-9.-]{6,20}$/
+
+/**
+ * Campo de texto opcional del PATCH: undefined = no cambia; null o "" = se borra.
+ * Devuelve el valor recortado o un fallo si es demasiado largo o no es texto.
+ */
+function textoOpcional(
+  v: unknown,
+  campo: string,
+  max: number,
+): { ok: true; cambia: false } | { ok: true; cambia: true; valor: string | null } | Fallo {
+  if (v === undefined) return { ok: true, cambia: false }
+  if (v === null) return { ok: true, cambia: true, valor: null }
+  if (typeof v !== 'string') return { ok: false, error: 'Tiene que ser texto.', campo }
+  const t = v.trim()
+  if (t.length > max) return { ok: false, error: `Puede tener hasta ${max} caracteres.`, campo }
+  return { ok: true, cambia: true, valor: t.length > 0 ? t : null }
+}
+
+/**
+ * Aplica los cambios de `patch` sobre la config actual, validando cada campo.
+ * Devuelve la config completa resultante (lista para guardar).
+ */
+export function aplicarPatchConfig(actual: TiendaConfig, patch: unknown): Ok<TiendaConfig> | Fallo {
+  if (patch === undefined) return { ok: true, data: actual }
+  if (!esObjeto(patch)) return { ok: false, error: 'Ajustes mal armados.', campo: 'config' }
+  const p = patch as NonNullable<ConfigPatchBody['config']> & Record<string, unknown>
+  const nueva: TiendaConfig = {
+    ...actual,
+    pago: { ...actual.pago },
+    retiro: { ...actual.retiro },
+  }
+
+  if (p.venta_habilitada !== undefined) {
+    if (typeof p.venta_habilitada !== 'boolean') {
+      return { ok: false, error: 'Tiene que ser sí o no.', campo: 'config.venta_habilitada' }
+    }
+    nueva.venta_habilitada = p.venta_habilitada
+  }
+
+  const mensaje = textoOpcional(p.mensaje, 'config.mensaje', 280)
+  if (!mensaje.ok) return mensaje
+  if (mensaje.cambia) nueva.mensaje = mensaje.valor
+
+  if (p.whatsapp !== undefined) {
+    if (p.whatsapp === null || (typeof p.whatsapp === 'string' && p.whatsapp.trim() === '')) {
+      nueva.whatsapp = null
+    } else if (typeof p.whatsapp === 'string') {
+      const wa = p.whatsapp.replace(/[\s()+-]/g, '')
+      if (!/^\d{10,15}$/.test(wa)) {
+        return {
+          ok: false,
+          error: 'El WhatsApp va con código de país y sin el 15, solo números: 549381XXXXXXX.',
+          campo: 'config.whatsapp',
+        }
+      }
+      nueva.whatsapp = wa
+    } else {
+      return { ok: false, error: 'Tiene que ser texto.', campo: 'config.whatsapp' }
+    }
+  }
+
+  if (p.vencimiento_horas !== undefined) {
+    const h = p.vencimiento_horas
+    if (typeof h !== 'number' || !Number.isInteger(h) || h < 1 || h > VENCIMIENTO_MAX_HORAS) {
+      return {
+        ok: false,
+        error: `Las horas de reserva van de 1 a ${VENCIMIENTO_MAX_HORAS}.`,
+        campo: 'config.vencimiento_horas',
+      }
+    }
+    nueva.vencimiento_horas = h
+  }
+
+  if (p.pago !== undefined) {
+    if (!esObjeto(p.pago)) return { ok: false, error: 'Datos de pago mal armados.', campo: 'config.pago' }
+    const pago = p.pago as Partial<DatosPago>
+
+    const alias = textoOpcional(pago.alias, 'config.pago.alias', 20)
+    if (!alias.ok) return alias
+    if (alias.cambia) {
+      if (alias.valor !== null && !ALIAS_REGEX.test(alias.valor)) {
+        return {
+          ok: false,
+          error: 'El alias tiene entre 6 y 20 caracteres: letras, números, puntos o guiones.',
+          campo: 'config.pago.alias',
+        }
+      }
+      nueva.pago.alias = alias.valor
+    }
+
+    const cbu = textoOpcional(pago.cbu, 'config.pago.cbu', 40)
+    if (!cbu.ok) return cbu
+    if (cbu.cambia) {
+      const limpio = cbu.valor?.replace(/[\s-]/g, '') ?? null
+      if (limpio !== null && !/^\d{22}$/.test(limpio)) {
+        return { ok: false, error: 'El CBU/CVU tiene 22 números.', campo: 'config.pago.cbu' }
+      }
+      nueva.pago.cbu = limpio
+    }
+
+    const titular = textoOpcional(pago.titular, 'config.pago.titular', 120)
+    if (!titular.ok) return titular
+    if (titular.cambia) nueva.pago.titular = titular.valor
+
+    const banco = textoOpcional(pago.banco, 'config.pago.banco', 80)
+    if (!banco.ok) return banco
+    if (banco.cambia) nueva.pago.banco = banco.valor
+
+    const cuit = textoOpcional(pago.cuit, 'config.pago.cuit', 20)
+    if (!cuit.ok) return cuit
+    if (cuit.cambia) {
+      if (cuit.valor !== null && cuit.valor.replace(/\D/g, '').length !== 11) {
+        return { ok: false, error: 'El CUIT tiene 11 números (20-12345678-9).', campo: 'config.pago.cuit' }
+      }
+      nueva.pago.cuit = cuit.valor
+    }
+  }
+
+  if (p.retiro !== undefined) {
+    if (!esObjeto(p.retiro)) return { ok: false, error: 'Datos de retiro mal armados.', campo: 'config.retiro' }
+    const retiro = p.retiro as Partial<DatosRetiro>
+    const campos: Array<[keyof DatosRetiro, number]> = [
+      ['direccion', 200],
+      ['horario', 200],
+      ['indicaciones', 300],
+    ]
+    for (const [k, max] of campos) {
+      const r = textoOpcional(retiro[k], `config.retiro.${k}`, max)
+      if (!r.ok) return r
+      if (r.cambia) nueva.retiro[k] = r.valor
+    }
+  }
+
+  // No se puede abrir la venta sin dónde cobrar ni dónde recibir el comprobante.
+  if (nueva.venta_habilitada) {
+    if (!nueva.pago.alias && !nueva.pago.cbu) {
+      return {
+        ok: false,
+        error: 'Cargá el alias o el CBU antes de activar la venta web.',
+        campo: 'config.pago.alias',
+      }
+    }
+    if (!nueva.whatsapp) {
+      return {
+        ok: false,
+        error: 'Cargá el WhatsApp donde llegan los comprobantes antes de activar la venta web.',
+        campo: 'config.whatsapp',
+      }
+    }
+  }
+
+  return { ok: true, data: nueva }
+}
+
+export type CambioProducto = {
+  id: string
+  cambios: Partial<Pick<TiendaProductoRow, 'nombre' | 'descripcion' | 'disponible' | 'max_por_pedido'>> & {
+    precio?: number
+  }
+}
+
+/** Valida los cambios de productos. `actuales` sirve para chequear que existan y el precio final. */
+export function validarPatchProductos(
+  patch: unknown,
+  actuales: TiendaProductoRow[],
+): Ok<CambioProducto[]> | Fallo {
+  if (patch === undefined) return { ok: true, data: [] }
+  if (!Array.isArray(patch) || patch.length > 50) {
+    return { ok: false, error: 'Productos mal armados.', campo: 'productos' }
+  }
+  const out: CambioProducto[] = []
+  for (let i = 0; i < patch.length; i++) {
+    const base = `productos.${i}`
+    const p = patch[i]
+    if (!esObjeto(p) || typeof p.id !== 'string') return { ok: false, error: 'Producto mal armado.', campo: base }
+    const actual = actuales.find((a) => a.id === p.id)
+    if (!actual) return { ok: false, error: 'Ese producto no existe.', campo: `${base}.id` }
+
+    const cambios: CambioProducto['cambios'] = {}
+
+    if (p.precio !== undefined) {
+      const precio = p.precio
+      if (typeof precio !== 'number' || !Number.isFinite(precio) || precio < 0 || precio > 10_000_000) {
+        return { ok: false, error: 'Precio inválido.', campo: `${base}.precio` }
+      }
+      cambios.precio = Math.round(precio * 100) / 100
+    }
+
+    if (p.disponible !== undefined) {
+      if (typeof p.disponible !== 'boolean') {
+        return { ok: false, error: 'Tiene que ser sí o no.', campo: `${base}.disponible` }
+      }
+      cambios.disponible = p.disponible
+    }
+
+    if (p.nombre !== undefined) {
+      const n = typeof p.nombre === 'string' ? p.nombre.trim() : ''
+      if (n.length < 2 || n.length > 80) {
+        return { ok: false, error: 'El nombre va de 2 a 80 caracteres.', campo: `${base}.nombre` }
+      }
+      cambios.nombre = n
+    }
+
+    const desc = textoOpcional(p.descripcion, `${base}.descripcion`, 300)
+    if (!desc.ok) return desc
+    if (desc.cambia) cambios.descripcion = desc.valor
+
+    if (p.max_por_pedido !== undefined) {
+      const m = p.max_por_pedido
+      if (typeof m !== 'number' || !Number.isInteger(m) || m < 1 || m > 20) {
+        return { ok: false, error: 'El máximo por pedido va de 1 a 20.', campo: `${base}.max_por_pedido` }
+      }
+      cambios.max_por_pedido = m
+    }
+
+    const precioFinal = cambios.precio ?? Number(actual.precio)
+    const disponibleFinal = cambios.disponible ?? actual.disponible
+    if (disponibleFinal && !(precioFinal > 0)) {
+      return {
+        ok: false,
+        error: `Poné un precio a "${cambios.nombre ?? actual.nombre}" antes de marcarlo disponible.`,
+        campo: `${base}.precio`,
+      }
+    }
+
+    if (Object.keys(cambios).length > 0) out.push({ id: p.id, cambios })
+  }
+  return { ok: true, data: out }
+}
