+'use client'
+
+import { useId, useState, type ReactNode } from 'react'
+import useSWR from 'swr'
+import { AlertTriangle, Check, KeyRound, Loader2, Save } from 'lucide-react'
+import { apiFetcher } from '@/lib/swr/fetchers'
+import { errorToast, successToast } from '@/lib/toast-helpers'
+import { cn } from '@/lib/utils'
+import type { ConfigPatchBody, ProductoStaff, RespuestaConfigStaff } from '@/lib/tienda/tipos'
+import { fmtPesos } from './formato'
+
+// ---------------------------------------------------------------------------
+// Ajustes de la tienda web (solo socio y encargado):
+// interruptor de venta, datos de pago, WhatsApp, retiro, reserva, mensaje y,
+// por producto, precio / disponible / máximo por pedido.
+// ---------------------------------------------------------------------------
+
+const INPUT =
+  'h-11 w-full rounded-xl border border-[#ebe6df] bg-white px-3 text-sm text-[#3d2c24] placeholder:text-[#a39e97] focus:border-[#006d5a] focus:outline-none focus:ring-1 focus:ring-[#006d5a]'
+
+/** "9.500" / "9500" / "9500,50" / "$ 9.500" → 9500 | 9500.5. null si no se entiende. */
+function parsePesos(v: string): number | null {
+  let t = v.replace(/[$\s]/g, '')
+  if (t === '') return 0
+  if (t.includes(',')) t = t.replace(/\./g, '').replace(',', '.')
+  else if (/^\d{1,3}(\.\d{3})+$/.test(t)) t = t.replace(/\./g, '')
+  const n = Number(t)
+  return Number.isFinite(n) && n >= 0 ? n : null
+}
+
+function Campo({ label, ayuda, children }: { label: string; ayuda?: string; children: (id: string) => ReactNode }) {
+  const id = useId()
+  return (
+    <div>
+      <label htmlFor={id} className="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-[#7d6c64]">
+        {label}
+      </label>
+      {children(id)}
+      {ayuda && <p className="mt-1 text-[11px] text-[#a39e97]">{ayuda}</p>}
+    </div>
+  )
+}
+
+function Interruptor({
+  activo, onChange, label, descripcion,
+}: { activo: boolean; onChange: (v: boolean) => void; label: string; descripcion?: string }) {
+  return (
+    <button
+      type="button"
+      role="switch"
+      aria-checked={activo}
+      onClick={() => onChange(!activo)}
+      className="flex min-h-11 w-full items-center gap-3 text-left"
+    >
+      <span className="min-w-0 flex-1">
+        <span className="block text-sm font-semibold text-[#3d2c24]">{label}</span>
+        {descripcion && <span className="block text-[11px] text-[#a39e97]">{descripcion}</span>}
+      </span>
+      <span
+        aria-hidden
+        className={cn(
+          'relative h-7 w-12 shrink-0 rounded-full transition-colors',
+          activo ? 'bg-[#006d5a]' : 'bg-[#d9d3cb]',
+        )}
+      >
+        <span
+          className={cn(
+            'absolute top-1 size-5 rounded-full bg-white shadow transition-transform',
+            activo ? 'translate-x-6' : 'translate-x-1',
+          )}
+        />
+      </span>
+    </button>
+  )
+}
+
+type ProductoForm = { id: string; nombre: string; presentacion: string | null; precio: string; disponible: boolean; max: string }
+
+function Formulario({ datos, onGuardado }: { datos: RespuestaConfigStaff; onGuardado: (d: RespuestaConfigStaff) => void }) {
+  const c = datos.config
+  const [ventaHabilitada, setVentaHabilitada] = useState(c.venta_habilitada)
+  const [mensaje, setMensaje] = useState(c.mensaje ?? '')
+  const [alias, setAlias] = useState(c.pago.alias ?? '')
+  const [cbu, setCbu] = useState(c.pago.cbu ?? '')
+  const [titular, setTitular] = useState(c.pago.titular ?? '')
+  const [banco, setBanco] = useState(c.pago.banco ?? '')
+  const [cuit, setCuit] = useState(c.pago.cuit ?? '')
+  const [whatsapp, setWhatsapp] = useState(c.whatsapp ?? '')
+  const [direccion, setDireccion] = useState(c.retiro.direccion ?? '')
+  const [horario, setHorario] = useState(c.retiro.horario ?? '')
+  const [indicaciones, setIndicaciones] = useState(c.retiro.indicaciones ?? '')
+  const [horas, setHoras] = useState(String(c.vencimiento_horas))
+  const [productos, setProductos] = useState<ProductoForm[]>(() =>
+    datos.productos.map((p: ProductoStaff) => ({
+      id: p.id,
+      nombre: p.nombre,
+      presentacion: p.presentacion,
+      precio: p.precio > 0 ? String(p.precio) : '',
+      disponible: p.disponible,
+      max: String(p.max_por_pedido),
+    })),
+  )
+  const [guardando, setGuardando] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+
+  function cambiarProducto(id: string, cambios: Partial<ProductoForm>) {
+    setProductos((ps) => ps.map((p) => (p.id === id ? { ...p, ...cambios } : p)))
+  }
+
+  async function guardar() {
+    setError(null)
+    const horasNum = Number(horas)
+    const productosBody: NonNullable<ConfigPatchBody['productos']> = []
+    for (const p of productos) {
+      const precio = parsePesos(p.precio)
+      if (precio === null) {
+        setError(`Revisá el precio de "${p.nombre}": solo números (por ejemplo 9500).`)
+        return
+      }
+      productosBody.push({ id: p.id, precio, disponible: p.disponible, max_por_pedido: Number(p.max) })
+    }
+    const body: ConfigPatchBody = {
+      config: {
+        venta_habilitada: ventaHabilitada,
+        mensaje: mensaje.trim() || null,
+        pago: {
+          alias: alias.trim() || null,
+          cbu: cbu.trim() || null,
+          titular: titular.trim() || null,
+          banco: banco.trim() || null,
+          cuit: cuit.trim() || null,
+        },
+        whatsapp: whatsapp.trim() || null,
+        retiro: {
+          direccion: direccion.trim() || null,
+          horario: horario.trim() || null,
+          indicaciones: indicaciones.trim() || null,
+        },
+        vencimiento_horas: Number.isFinite(horasNum) ? horasNum : 0,
+      },
+      productos: productosBody,
+    }
+
+    setGuardando(true)
+    try {
+      const res = await fetch('/api/tienda/config', {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(body),
+      })
+      const json = await res.json().catch(() => ({}))
+      if (!res.ok) {
+        setError(json.error ?? 'No se pudieron guardar los ajustes.')
+        return
+      }
+      const nuevos = json as RespuestaConfigStaff
+      onGuardado(nuevos)
+      successToast(
+        'Ajustes guardados',
+        nuevos.config.venta_habilitada ? 'La venta web está activa.' : 'La venta web está pausada.',
+      )
+    } catch (err) {
+      errorToast('No se pudieron guardar los ajustes', err)
+    } finally {
+      setGuardando(false)
+    }
+  }
+
+  return (
+    <form
+      onSubmit={(e) => {
+        e.preventDefault()
+        void guardar()
+      }}
+      className="space-y-4"
+    >
+      {/* Estado de la conexión con la landing */}
+      <div className="space-y-1.5 rounded-xl bg-[#faf8f5] px-3 py-2.5 text-[11px] text-[#7d6c64]">
+        <p className="flex items-center gap-1.5">
+          <KeyRound className="size-3.5 shrink-0" aria-hidden />
+          {datos.secreto_configurado ? (
+            <span>Conexión con la web configurada (TIENDA_API_SECRET cargado).</span>
+          ) : (
+            <span className="font-semibold text-[#ea504c]">
+              Falta TIENDA_API_SECRET en Vercel: la web no puede crear ventas en esta sucursal.
+            </span>
+          )}
+        </p>
+        <p>
+          Los pedidos salen con el código <span className="font-mono font-semibold text-[#3d2c24]">{datos.prefijo}-0001</span>.
+        </p>
+      </div>
+
+      <section aria-labelledby="ajustes-venta" className="rounded-2xl bg-white p-4 ring-1 ring-[#ebe6df]">
+        <h3 id="ajustes-venta" className="section-label mb-2">Venta web</h3>
+        <Interruptor
+          activo={ventaHabilitada}
+          onChange={setVentaHabilitada}
+          label={ventaHabilitada ? 'Venta activa' : 'Venta pausada'}
+          descripcion="Si la pausás, la web muestra el café pero no deja comprar."
+        />
+        <div className="mt-3">
+          <Campo label="Aviso arriba del formulario" ayuda='Opcional. Ej.: "Esta semana solo en grano".'>
+            {(id) => (
+              <textarea
+                id={id}
+                value={mensaje}
+                onChange={(e) => setMensaje(e.target.value)}
+                maxLength={280}
+                rows={2}
+                className={cn(INPUT, 'h-auto py-2')}
+              />
+            )}
+          </Campo>
+        </div>
+      </section>
+
+      <section aria-labelledby="ajustes-productos" className="rounded-2xl bg-white p-4 ring-1 ring-[#ebe6df]">
+        <h3 id="ajustes-productos" className="section-label mb-2">Productos</h3>
+        {productos.length === 0 && (
+          <p className="text-xs text-[#a39e97]">No hay productos cargados. Revisá que se haya aplicado la migración.</p>
+        )}
+        <div className="space-y-4">
+          {productos.map((p) => {
+            const precio = parsePesos(p.precio)
+            return (
+              <div key={p.id} className="space-y-2 border-t border-[#f5f0ea] pt-3 first:border-t-0 first:pt-0">
+                <p className="text-sm font-semibold text-[#3d2c24]">
+                  {p.nombre}
+                  {p.presentacion && <span className="font-normal text-[#a39e97]"> · {p.presentacion}</span>}
+                </p>
+                <div className="grid grid-cols-2 gap-2">
+                  <Campo label="Precio" ayuda={precio && precio > 0 ? fmtPesos(precio) : 'Sin precio no se vende'}>
+                    {(id) => (
+                      <input
+                        id={id}
+                        inputMode="decimal"
+                        value={p.precio}
+                        onChange={(e) => cambiarProducto(p.id, { precio: e.target.value })}
+                        placeholder="9500"
+                        className={INPUT}
+                      />
+                    )}
+                  </Campo>
+                  <Campo label="Máx. por pedido">
+                    {(id) => (
+                      <input
+                        id={id}
+                        type="number"
+                        inputMode="numeric"
+                        min={1}
+                        max={20}
+                        value={p.max}
+                        onChange={(e) => cambiarProducto(p.id, { max: e.target.value })}
+                        className={INPUT}
+                      />
+                    )}
+                  </Campo>
+                </div>
+                <Interruptor
+                  activo={p.disponible}
+                  onChange={(v) => cambiarProducto(p.id, { disponible: v })}
+                  label={p.disponible ? 'Hay stock' : 'Sin stock'}
+                  descripcion="Apagalo cuando se termine: en la web aparece como agotado."
+                />
+              </div>
+            )
+          })}
+        </div>
+      </section>
+
+      <section aria-labelledby="ajustes-pago" className="rounded-2xl bg-white p-4 ring-1 ring-[#ebe6df]">
+        <h3 id="ajustes-pago" className="section-label mb-2">Dónde transfieren</h3>
+        <div className="space-y-3">
+          <Campo label="Alias" ayuda="Lo que el cliente copia en la app del banco.">
+            {(id) => (
+              <input id={id} value={alias} onChange={(e) => setAlias(e.target.value)} autoCapitalize="none" autoCorrect="off" spellCheck={false} placeholder="la.vieja.escuela" className={INPUT} />
+            )}
+          </Campo>
+          <Campo label="CBU / CVU" ayuda="22 números. Opcional si hay alias.">
+            {(id) => (
+              <input id={id} value={cbu} onChange={(e) => setCbu(e.target.value)} inputMode="numeric" className={cn(INPUT, 'font-mono')} />
+            )}
+          </Campo>
+          <Campo label="Titular">
+            {(id) => <input id={id} value={titular} onChange={(e) => setTitular(e.target.value)} className={INPUT} />}
+          </Campo>
+          <div className="grid grid-cols-2 gap-2">
+            <Campo label="Banco">
+              {(id) => <input id={id} value={banco} onChange={(e) => setBanco(e.target.value)} className={INPUT} />}
+            </Campo>
+            <Campo label="CUIT">
+              {(id) => <input id={id} value={cuit} onChange={(e) => setCuit(e.target.value)} inputMode="numeric" className={INPUT} />}
+            </Campo>
+          </div>
+        </div>
+      </section>
+
+      <section aria-labelledby="ajustes-whatsapp" className="rounded-2xl bg-white p-4 ring-1 ring-[#ebe6df]">
+        <h3 id="ajustes-whatsapp" className="section-label mb-2">Comprobantes y retiro</h3>
+        <div className="space-y-3">
+          <Campo label="WhatsApp para comprobantes" ayuda="Con 549 adelante y sin el 15: 5493815551234.">
+            {(id) => (
+              <input id={id} value={whatsapp} onChange={(e) => setWhatsapp(e.target.value)} inputMode="numeric" placeholder="5493815551234" className={cn(INPUT, 'font-mono')} />
+            )}
+          </Campo>
+          <Campo label="Dirección de retiro">
+            {(id) => <input id={id} value={direccion} onChange={(e) => setDireccion(e.target.value)} className={INPUT} />}
+          </Campo>
+          <Campo label="Horario de retiro" ayuda='Ej.: "Lunes a sábado de 8 a 20".'>
+            {(id) => <input id={id} value={horario} onChange={(e) => setHorario(e.target.value)} className={INPUT} />}
+          </Campo>
+          <Campo label="Indicaciones" ayuda='Ej.: "Pedilo en la barra con tu código".'>
+            {(id) => (
+              <textarea id={id} value={indicaciones} onChange={(e) => setIndicaciones(e.target.value)} maxLength={300} rows={2} className={cn(INPUT, 'h-auto py-2')} />
+            )}
+          </Campo>
+          <Campo label="Horas de reserva sin pagar" ayuda="Pasado ese tiempo el pedido se cancela solo.">
+            {(id) => (
+              <input id={id} type="number" inputMode="numeric" min={1} max={720} value={horas} onChange={(e) => setHoras(e.target.value)} className={INPUT} />
+            )}
+          </Campo>
+        </div>
+      </section>
+
+      <div aria-live="polite">
+        {error && (
+          <p className="flex items-start gap-1.5 rounded-xl bg-[#fef2f2] px-3 py-2 text-xs font-semibold text-[#ea504c]">
+            <AlertTriangle className="mt-0.5 size-3.5 shrink-0" aria-hidden />
+            {error}
+          </p>
+        )}
+      </div>
+
+      <button
+        type="submit"
+        disabled={guardando}
+        className="flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-[#3d2c24] text-sm font-semibold text-white active:scale-[0.98] disabled:opacity-60"
+      >
+        {guardando ? <Loader2 className="size-4 animate-spin" aria-hidden /> : <Save className="size-4" aria-hidden />}
+        Guardar ajustes
+      </button>
+    </form>
+  )
+}
+
+export function AjustesTienda() {
+  const { data, error, isLoading, mutate } = useSWR<RespuestaConfigStaff>('/api/tienda/config', apiFetcher, {
+    revalidateOnFocus: false,
+  })
+  const [version, setVersion] = useState(0)
+
+  if (isLoading) {
+    return (
+      <div className="flex justify-center py-8">
+        <Loader2 className="size-5 animate-spin text-[#006d5a]" aria-label="Cargando ajustes" />
+      </div>
+    )
+  }
+  if (error || !data) {
+    return (
+      <p className="flex items-start gap-1.5 rounded-xl bg-[#fef2f2] px-3 py-2 text-xs font-semibold text-[#ea504c]">
+        <AlertTriangle className="mt-0.5 size-3.5 shrink-0" aria-hidden />
+        {error instanceof Error ? error.message : 'No se pudieron cargar los ajustes.'}
+      </p>
+    )
+  }
+
+  return (
+    <div>
+      {data.config.venta_habilitada && (
+        <p className="mb-3 flex items-center gap-1.5 text-xs font-semibold text-[#006d5a]">
+          <Check className="size-3.5" aria-hidden />
+          La venta web está activa.
+        </p>
+      )}
+      <Formulario
+        key={version}
+        datos={data}
+        onGuardado={(nuevos) => {
+          void mutate(nuevos, { revalidate: false })
+          setVersion((v) => v + 1)
+        }}
+      />
+    </div>
+  )
+}
