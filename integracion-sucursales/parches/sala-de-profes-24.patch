--- /dev/null
+++ b/src/app/api/tienda/publico/ventas/[codigo]/route.ts
@@ -0,0 +1,58 @@
+import { protegerRutaPublica } from '@/lib/tienda/auth'
+import { leerConfig } from '@/lib/tienda/config'
+import { faltaMigracion, tiendaAdmin } from '@/lib/tienda/db'
+import { detalleError, errorInterno, jsonPublico, noEncontrada } from '@/lib/tienda/respuestas'
+import type { ConsultarVentaRespuesta } from '@/lib/tienda/tipos'
+import {
+  aVentaPublica,
+  cargarVenta,
+  codigoConForma,
+  hashToken,
+  hashesIguales,
+  tokenConForma,
+  vencerPendientes,
+} from '@/lib/tienda/ventas'
+
+// ---------------------------------------------------------------------------
+// GET /api/tienda/publico/ventas/{codigo} — contrato v1 con la landing
+// ---------------------------------------------------------------------------
+// Estado de una venta para el ticket del cliente. Además del secreto de la
+// landing pide el token de esa venta en el header X-Venta-Token.
+// Código inexistente y token incorrecto devuelven EXACTAMENTE el mismo 404.
+// Antes de leer se vencen las pendientes (así el ticket muestra "cancelado"
+// aunque no haya pg_cron).
+// ---------------------------------------------------------------------------
+
+export const dynamic = 'force-dynamic'
+
+/** Hash de relleno para comparar igual cuando el código no existe. */
+const HASH_RELLENO = '0'.repeat(64)
+
+export async function GET(request: Request, context: { params: Promise<{ codigo: string }> }) {
+  const rechazo = protegerRutaPublica(request)
+  if (rechazo) return rechazo
+
+  const { codigo: crudo } = await context.params
+  const codigo = crudo.trim().toUpperCase()
+  const token = request.headers.get('x-venta-token')?.trim() ?? null
+  if (!codigoConForma(codigo) || !tokenConForma(token)) return noEncontrada()
+
+  try {
+    const admin = tiendaAdmin()
+    await vencerPendientes(admin)
+
+    const cargada = await cargarVenta(admin, { codigo })
+    // Se compara siempre (aunque no exista) para que el tiempo no delate nada.
+    const coincide = hashesIguales(hashToken(token), cargada?.venta.token_hash ?? HASH_RELLENO)
+    if (!cargada || !coincide || cargada.items.length === 0) return noEncontrada()
+
+    const config = await leerConfig(admin)
+    const respuesta: ConsultarVentaRespuesta = { venta: aVentaPublica(cargada, config) }
+    return jsonPublico(respuesta)
+  } catch (err) {
+    console.error(
+      `[tienda] GET ventas/{codigo}: ${faltaMigracion(err) ? 'falta la migración 20261004_tienda_web.sql' : detalleError(err)}`,
+    )
+    return errorInterno()
+  }
+}
diff --git a/src/app/api/tienda/publico/ventas/route.ts b/src/app/api/tienda/publico/ventas/route.ts
new file mode 100644
index 0000000..eacecbf
--- /dev/null
+++ b/src/app/api/tienda/publico/ventas/route.ts
@@ -0,0 +1,81 @@
+import { after } from 'next/server'
+import { notifyEvent } from '@/lib/push/notify-event'
+import { protegerRutaPublica } from '@/lib/tienda/auth'
+import { leerConfig, prefijoCodigo } from '@/lib/tienda/config'
+import { faltaMigracion, tiendaAdmin } from '@/lib/tienda/db'
+import { detalleError, errorInterno, errorPublico, jsonPublico } from '@/lib/tienda/respuestas'
+import { esCodigoError, type CrearVentaRespuesta, type ResultadoCrearVenta } from '@/lib/tienda/tipos'
+import { validarCrearVenta } from '@/lib/tienda/validar'
+import { aVentaPublica, cargarVenta, generarToken, nombreDePila, pesos } from '@/lib/tienda/ventas'
+
+// ---------------------------------------------------------------------------
+// POST /api/tienda/publico/ventas — contrato v1 con la landing
+// ---------------------------------------------------------------------------
+// Crea una venta 'pendiente_pago' con public.tienda_crear_venta(), que valida
+// de nuevo todo, toma el precio de esta base, aplica el límite por teléfono y
+// es idempotente por idempotency_key.
+//   201 { venta, token }  venta nueva
+//   200 { venta, token }  repetición de la misma idempotency_key (token nuevo)
+//   4xx { error, codigo, campo? } según STATUS_POR_ERROR
+// El token se devuelve UNA vez; acá se guarda solo su sha-256.
+// No se loguean datos del cliente (nombre, teléfono, email, nota).
+// ---------------------------------------------------------------------------
+
+export const dynamic = 'force-dynamic'
+
+export async function POST(request: Request) {
+  const rechazo = protegerRutaPublica(request)
+  if (rechazo) return rechazo
+
+  const body = await request.json().catch(() => null)
+  const validacion = validarCrearVenta(body)
+  if (!validacion.ok) {
+    return errorPublico('datos_invalidos', validacion.error, { campo: validacion.campo })
+  }
+
+  try {
+    const admin = tiendaAdmin()
+    const { token, hash } = generarToken()
+
+    const { data, error } = await admin.rpc('tienda_crear_venta', {
+      p_venta: validacion.data,
+      p_prefijo: prefijoCodigo(),
+      p_token_hash: hash,
+    })
+    if (error) throw error
+
+    const r = data as ResultadoCrearVenta | null
+    if (!r || typeof r !== 'object') throw new Error('tienda_crear_venta devolvió una respuesta vacía')
+
+    if (!r.ok) {
+      if (!esCodigoError(r.codigo) || r.codigo === 'error_interno') {
+        throw new Error(`tienda_crear_venta devolvió un código desconocido: ${String(r.codigo)}`)
+      }
+      return errorPublico(r.codigo, r.error, { campo: r.campo })
+    }
+
+    const [cargada, config] = await Promise.all([cargarVenta(admin, { id: r.venta_id }), leerConfig(admin)])
+    if (!cargada || cargada.items.length === 0) throw new Error(`venta ${r.codigo} creada pero no se pudo leer`)
+
+    const respuesta: CrearVentaRespuesta = { venta: aVentaPublica(cargada, config), token }
+
+    if (!r.repetida) {
+      const v = respuesta.venta
+      const bolsas = v.items.reduce((acc, it) => acc + it.cantidad, 0)
+      after(() =>
+        notifyEvent(admin, 'tienda_venta_nueva', {
+          title: 'Nueva venta web',
+          body: `${v.codigo} · ${nombreDePila(v.cliente_nombre)} · ${bolsas} ${bolsas === 1 ? 'bolsa' : 'bolsas'} · ${pesos(v.total)}. Esperando la transferencia.`,
+          url: '/tienda',
+        }).catch(() => {}),
+      )
+    }
+
+    return jsonPublico(respuesta, r.repetida ? 200 : 201)
+  } catch (err) {
+    console.error(
+      `[tienda] POST ventas: ${faltaMigracion(err) ? 'falta la migración 20261004_tienda_web.sql' : detalleError(err)}`,
+    )
+    return errorInterno()
+  }
+}
