@@ -0,0 +1,75 @@
+import { NextResponse } from 'next/server'
+import { requireRole } from '@/lib/supabase/require-role'
+import { faltaMigracion, MENSAJE_FALTA_MIGRACION, tiendaAdmin } from '@/lib/tienda/db'
+import { detalleError } from '@/lib/tienda/respuestas'
+import {
+  ESTADOS_VENTA,
+  esEstadoVenta,
+  type EstadoVenta,
+  type RespuestaVentasStaff,
+  type TiendaVentaRow,
+} from '@/lib/tienda/tipos'
+import { aVentaStaff, cargarItems, COLUMNAS_VENTA, nombresDePerfiles, vencerPendientes } from '@/lib/tienda/ventas'
+
+// ---------------------------------------------------------------------------
+// GET /api/tienda/ventas?estado=pendiente_pago|pagado|retirado|cancelado
+// ---------------------------------------------------------------------------
+// Ventas de la tienda web para la pantalla /tienda. Socio, encargado y
+// barista. Incluye teléfono y email del cliente (es para el equipo), los
+// items y cuántas ventas hay en cada estado (para las pestañas).
+// Últimas 200, de la más nueva a la más vieja.
+// ---------------------------------------------------------------------------
+
+export const dynamic = 'force-dynamic'
+
+const LIMITE = 200
+
+export async function GET(request: Request) {
+  const auth = await requireRole(['socio', 'encargado', 'barista'])
+  if (auth.response) return auth.response
+
+  const estadoParam = new URL(request.url).searchParams.get('estado')
+  if (estadoParam !== null && !esEstadoVenta(estadoParam)) {
+    return NextResponse.json({ error: 'Estado inválido' }, { status: 400 })
+  }
+  const estado: EstadoVenta | null = estadoParam
+
+  try {
+    const admin = tiendaAdmin()
+    await vencerPendientes(admin)
+
+    let q = admin.from('tienda_ventas').select(COLUMNAS_VENTA).order('created_at', { ascending: false }).limit(LIMITE)
+    if (estado) q = q.eq('estado', estado)
+
+    const [lista, ...conteos] = await Promise.all([
+      q,
+      ...ESTADOS_VENTA.map((e) =>
+        admin.from('tienda_ventas').select('id', { count: 'exact', head: true }).eq('estado', e),
+      ),
+    ])
+    if (lista.error) throw lista.error
+
+    const filas = (lista.data ?? []) as unknown as TiendaVentaRow[]
+    const [items, nombres] = await Promise.all([
+      cargarItems(admin, filas.map((f) => f.id)),
+      nombresDePerfiles(
+        admin,
+        filas.flatMap((f) => [f.pagado_por, f.retirado_por, f.cancelado_por]),
+      ),
+    ])
+
+    const respuesta: RespuestaVentasStaff = {
+      ventas: filas.map((f) => aVentaStaff(f, items.get(f.id) ?? [], nombres)),
+      conteos: Object.fromEntries(
+        ESTADOS_VENTA.map((e, i) => [e, conteos[i]?.count ?? 0]),
+      ) as Record<EstadoVenta, number>,
+    }
+    return NextResponse.json(respuesta, { headers: { 'Cache-Control': 'no-store' } })
+  } catch (err) {
+    if (faltaMigracion(err)) {
+      return NextResponse.json({ error: MENSAJE_FALTA_MIGRACION, migracion_pendiente: true }, { status: 503 })
+    }
+    console.error('[tienda] GET /api/tienda/ventas:', detalleError(err))
+    return NextResponse.json({ error: 'No se pudieron cargar las ventas web' }, { status: 500 })
+  }
+}
