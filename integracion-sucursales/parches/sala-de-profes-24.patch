+'use client'
+
+import { useState } from 'react'
+import {
+  Check, Clock, Loader2, MessageCircle, Package, Phone, StickyNote, X, Ban, AlertTriangle,
+} from 'lucide-react'
+import { cn } from '@/lib/utils'
+import type { VentaStaff } from '@/lib/tienda/tipos'
+import {
+  ESTADO_UI, fmtFechaHora, fmtPesos, fmtRelativo, linkTelefono, linkWhatsAppCliente, unidades,
+} from './formato'
+
+// ---------------------------------------------------------------------------
+// Tarjeta de una venta web, con las acciones que corresponden al rol.
+// Confirmación inline en dos pasos (como en /pedidos/cuentas).
+// ---------------------------------------------------------------------------
+
+export type AccionVenta = 'pagado' | 'retirado' | 'cancelado'
+
+type Props = {
+  venta: VentaStaff
+  /** socio o encargado: puede cobrar y cancelar */
+  esManager: boolean
+  ahora: number
+  /** Devuelve true si salió bien (para cerrar la confirmación). */
+  onAccion: (venta: VentaStaff, accion: AccionVenta, motivo: string | null) => Promise<boolean>
+}
+
+const SEIS_HORAS = 6 * 60 * 60 * 1000
+
+export function VentaCard({ venta, esManager, ahora, onAccion }: Props) {
+  const [confirmando, setConfirmando] = useState<AccionVenta | null>(null)
+  const [motivo, setMotivo] = useState('')
+  const [enviando, setEnviando] = useState(false)
+
+  const ui = ESTADO_UI[venta.estado]
+  const bolsas = unidades(venta.items)
+  const wa = linkWhatsAppCliente(venta.cliente_telefono, venta.cliente_nombre, venta.codigo)
+
+  const venceMs = new Date(venta.vence_at).getTime() - ahora
+  const pendiente = venta.estado === 'pendiente_pago'
+  const vencePronto = pendiente && venceMs < SEIS_HORAS
+  const motivoObligatorio = confirmando === 'cancelado' && venta.estado === 'pagado'
+
+  async function confirmar() {
+    if (!confirmando) return
+    if (motivoObligatorio && motivo.trim().length < 3) return
+    setEnviando(true)
+    const ok = await onAccion(venta, confirmando, motivo.trim() || null)
+    setEnviando(false)
+    if (ok) {
+      setConfirmando(null)
+      setMotivo('')
+    }
+  }
+
+  function abrir(accion: AccionVenta) {
+    setMotivo('')
+    setConfirmando(accion)
+  }
+
+  const pregunta: Record<AccionVenta, string> = {
+    pagado: `¿Llegó el comprobante por el monto exacto (${fmtPesos(venta.total)})?`,
+    retirado: `¿Le entregaste ${bolsas === 1 ? 'la bolsa' : `las ${bolsas} bolsas`} a ${venta.cliente_nombre}? Pedile el código ${venta.codigo}.`,
+    cancelado:
+      venta.estado === 'pagado'
+        ? 'Esta venta ya está pagada: si la cancelás, hay que devolver la transferencia. ¿Por qué se cancela?'
+        : '¿Cancelamos este pedido? El cliente lo va a ver cancelado en su ticket.',
+  }
+
+  return (
+    <article
+      aria-labelledby={`venta-${venta.id}`}
+      className="overflow-hidden rounded-2xl bg-white ring-1 ring-[#ebe6df]"
+    >
+      {/* Encabezado: código, estado y total */}
+      <div className="flex items-start gap-3 px-4 pt-3.5">
+        <div className="min-w-0 flex-1">
+          <div className="flex flex-wrap items-center gap-2">
+            <h3 id={`venta-${venta.id}`} className="font-mono text-sm font-bold tracking-tight text-[#3d2c24]">
+              {venta.codigo}
+            </h3>
+            <span
+              className="rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider"
+              style={{ color: ui.color, backgroundColor: ui.bg }}
+            >
+              {ui.label}
+            </span>
+          </div>
+          <p className="mt-0.5 text-[11px] text-[#a39e97]">
+            {fmtFechaHora(venta.creado_at)} · {fmtRelativo(venta.creado_at, ahora)}
+          </p>
+        </div>
+        <p className="shrink-0 font-display text-xl font-bold tabular-nums text-[#3d2c24]">{fmtPesos(venta.total)}</p>
+      </div>
+
+      {/* Cliente */}
+      <div className="mt-3 flex items-center gap-2 px-4">
+        <p className="min-w-0 flex-1 truncate text-sm font-semibold text-[#3d2c24]">{venta.cliente_nombre}</p>
+        <a
+          href={linkTelefono(venta.cliente_telefono)}
+          className="flex h-11 shrink-0 items-center gap-1.5 rounded-xl bg-[#f3efe9] px-3 text-xs font-semibold text-[#3d2c24] active:scale-95"
+          aria-label={`Llamar a ${venta.cliente_nombre} al ${venta.cliente_telefono}`}
+        >
+          <Phone className="size-3.5" aria-hidden />
+          <span className="tabular-nums">{venta.cliente_telefono}</span>
+        </a>
+        {wa && (
+          <a
+            href={wa}
+            target="_blank"
+            rel="noopener noreferrer"
+            className="flex size-11 shrink-0 items-center justify-center rounded-xl bg-[#e8f5f1] text-[#006d5a] active:scale-95"
+            aria-label={`Escribirle por WhatsApp a ${venta.cliente_nombre}`}
+          >
+            <MessageCircle className="size-4" aria-hidden />
+          </a>
+        )}
+      </div>
+      {venta.cliente_email && (
+        <p className="mt-1 truncate px-4 text-[11px] text-[#a39e97]">{venta.cliente_email}</p>
+      )}
+
+      {/* Items */}
+      <ul className="mx-4 mt-3 divide-y divide-[#f5f0ea] rounded-xl bg-[#faf8f5] px-3">
+        {venta.items.map((it, i) => (
+          <li key={i} className="flex items-start gap-2 py-2">
+            <Package className="mt-0.5 size-3.5 shrink-0 text-[#a39e97]" aria-hidden />
+            <div className="min-w-0 flex-1">
+              <p className="text-xs font-medium text-[#3d2c24]">
+                <span className="tabular-nums">{it.cantidad} ×</span> {it.nombre}
+              </p>
+              {it.detalle && <p className="text-[11px] font-semibold text-[#006d5a]">{it.detalle}</p>}
+            </div>
+            <span className="shrink-0 text-xs font-semibold tabular-nums text-[#3d2c24]">{fmtPesos(it.subtotal)}</span>
+          </li>
+        ))}
+      </ul>
+
+      {venta.nota && (
+        <p className="mx-4 mt-2 flex items-start gap-1.5 rounded-xl bg-[#fdf6ec] px-3 py-2 text-xs text-[#3d2c24]">
+          <StickyNote className="mt-0.5 size-3.5 shrink-0 text-[#d4943a]" aria-hidden />
+          <span className="min-w-0 break-words">{venta.nota}</span>
+        </p>
+      )}
+
+      {/* Vencimiento y recorrido */}
+      <div className="mt-2 space-y-1 px-4 text-[11px]">
+        {pendiente && (
+          <p
+            className={cn(
+              'flex items-center gap-1.5 font-semibold',
+              vencePronto ? 'rounded-lg bg-[#fdf6ec] px-2 py-1 text-[#d4943a]' : 'text-[#a39e97]',
+            )}
+          >
+            <Clock className="size-3.5" aria-hidden />
+            {venceMs > 0
+              ? `Vence ${fmtRelativo(venta.vence_at, ahora)} (${fmtFechaHora(venta.vence_at)})`
+              : 'Vencido: se cancela solo en la próxima actualización'}
+          </p>
+        )}
+        {venta.pagado_at && (
+          <p className="text-[#a39e97]">
+            Cobrado {fmtFechaHora(venta.pagado_at)}{venta.pagado_por_nombre ? ` por ${venta.pagado_por_nombre}` : ''}
+          </p>
+        )}
+        {venta.retirado_at && (
+          <p className="text-[#a39e97]">
+            Entregado {fmtFechaHora(venta.retirado_at)}{venta.retirado_por_nombre ? ` por ${venta.retirado_por_nombre}` : ''}
+          </p>
+        )}
+        {venta.cancelado_at && (
+          <p className="text-[#ea504c]">
+            Cancelado {fmtFechaHora(venta.cancelado_at)}
+            {venta.motivo_cancelacion === 'vencido'
+              ? ' · venció sin pago'
+              : `${venta.cancelado_por_nombre ? ` por ${venta.cancelado_por_nombre}` : ''}${venta.motivo_cancelacion ? ` · ${venta.motivo_cancelacion}` : ''}`}
+          </p>
+        )}
+      </div>
+
+      {/* Acciones */}
+      <div className="mt-3 border-t border-[#f5f0ea] px-4 py-3">
+        {confirmando ? (
+          <div role="group" aria-label="Confirmar acción">
+            <p className="text-xs font-semibold text-[#3d2c24]">{pregunta[confirmando]}</p>
+            {confirmando === 'cancelado' && (
+              <label className="mt-2 block">
+                <span className="sr-only">Motivo de la cancelación</span>
+                <input
+                  type="text"
+                  value={motivo}
+                  onChange={(e) => setMotivo(e.target.value)}
+                  maxLength={200}
+                  placeholder={motivoObligatorio ? 'Motivo (obligatorio)' : 'Motivo (opcional)'}
+                  className="h-11 w-full rounded-xl border border-[#ebe6df] bg-white px-3 text-sm text-[#3d2c24] placeholder:text-[#a39e97] focus:border-[#006d5a] focus:outline-none focus:ring-1 focus:ring-[#006d5a]"
+                />
+              </label>
+            )}
+            <div className="mt-2 flex items-center gap-2">
+              <button
+                type="button"
+                onClick={() => setConfirmando(null)}
+                disabled={enviando}
+                className="flex h-11 flex-1 items-center justify-center gap-1 rounded-xl bg-[#f3efe9] text-xs font-semibold text-[#7d6c64] active:scale-95 disabled:opacity-60"
+              >
+                <X className="size-3.5" aria-hidden />
+                {confirmando === 'cancelado' ? 'Volver' : 'Cancelar'}
+              </button>
+              <button
+                type="button"
+                onClick={() => void confirmar()}
+                disabled={enviando || (motivoObligatorio && motivo.trim().length < 3)}
+                className="flex h-11 flex-1 items-center justify-center gap-1 rounded-xl bg-[#3d2c24] text-xs font-semibold text-white active:scale-95 disabled:opacity-40"
+              >
+                {enviando ? <Loader2 className="size-3.5 animate-spin" aria-hidden /> : <Check className="size-3.5" aria-hidden />}
+                {confirmando === 'pagado' ? 'Sí, llegó' : confirmando === 'retirado' ? 'Sí, entregado' : 'Cancelar venta'}
+              </button>
+            </div>
+          </div>
+        ) : venta.estado === 'pendiente_pago' ? (
+          esManager ? (
+            <div className="flex items-center gap-2">
+              <button
+                type="button"
+                onClick={() => abrir('pagado')}
+                className="flex h-11 flex-1 items-center justify-center gap-1.5 rounded-xl bg-[#006d5a] text-xs font-semibold text-white active:scale-95"
+              >
+                <Check className="size-3.5" aria-hidden />
+                Marcar pagado
+              </button>
+              <button
+                type="button"
+                onClick={() => abrir('cancelado')}
+                className="flex h-11 items-center justify-center gap-1.5 rounded-xl px-3 text-xs font-semibold text-[#ea504c] ring-1 ring-[#ea504c]/30 active:scale-95"
+              >
+                <Ban className="size-3.5" aria-hidden />
+                Cancelar
+              </button>
+            </div>
+          ) : (
+            <p className="flex items-center gap-1.5 text-[11px] text-[#7d6c64]">
+              <AlertTriangle className="size-3.5 text-[#d4943a]" aria-hidden />
+              Lo cobra un encargado o un socio cuando llegue el comprobante.
+            </p>
+          )
+        ) : venta.estado === 'pagado' ? (
+          <div className="flex items-center gap-2">
+            <button
+              type="button"
+              onClick={() => abrir('retirado')}
+              className="flex h-11 flex-1 items-center justify-center gap-1.5 rounded-xl bg-[#006d5a] text-xs font-semibold text-white active:scale-95"
+            >
+              <Package className="size-3.5" aria-hidden />
+              Entregado
+            </button>
+            {esManager && (
+              <button
+                type="button"
+                onClick={() => abrir('cancelado')}
+                className="flex h-11 items-center justify-center gap-1.5 rounded-xl px-3 text-xs font-semibold text-[#ea504c] ring-1 ring-[#ea504c]/30 active:scale-95"
+              >
+                <Ban className="size-3.5" aria-hidden />
+                Cancelar
+              </button>
+            )}
+          </div>
+        ) : (
+          <p className="text-[11px] text-[#a39e97]">
+            {venta.estado === 'retirado' ? 'Venta cerrada.' : 'Venta cancelada.'}
+          </p>
+        )}
+      </div>
+    </article>
+  )
+}
